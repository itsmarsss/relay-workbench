{
  "name": "relay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts && node scripts/smoke.mjs",
    "test:e2e": "pnpm run build && node scripts/workflow-e2e.mjs",
    "test:workspace": "pnpm run build && node scripts/workspace-e2e.mjs",
    "test:ui": "pnpm run build && node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "motion": "^14.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.2.9",
    "@types/react-dom": "18.2.4",
    "axe-core": "4.14.0",
    "esbuild": "0.28.1",
    "playwright": "^1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
