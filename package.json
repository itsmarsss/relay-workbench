{
  "name": "relay-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local workbench for human-directed, multi-harness development",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:browser": "node test/live-dom.e2e.js && node test/browser.e2e.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor.js"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
